import nltk
nltk.download('wordnet')
nltk.download('omw-1.4')
from nltk.corpus import wordnet as wn
def lesk(word, sentence):
    word = word.lower()
    sentence = sentence.lower().split()
    best_sense = None
    max_overlap = 0
    for sense in wn.synsets(word):
        definition_words = set(
            sense.definition().lower().split()
        )
        context_words = set(sentence)
        overlap = len(
            definition_words.intersection(context_words)
        )
        if overlap > max_overlap:
            max_overlap = overlap
            best_sense = sense
    return best_sense
sentence = input("Enter sentence: ")
word = input("Enter word to disambiguate: ")
sense = lesk(word, sentence)
if sense:
    print("\nBest Sense:", sense.name())
    print("Definition:", sense.definition())
else:
    print("No sense found.")
