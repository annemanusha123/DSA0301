# Subject-Verb Agreement Checker
singular_subjects = ["he", "she", "the boy", "the girl"]
plural_subjects = ["they", "we", "the boys", "the girls"]
singular_verbs = ["runs", "eats", "plays", "likes"]
plural_verbs = ["run", "eat", "play", "like"]
def check_agreement(sentence):
    words = sentence.lower().split()
    if len(words) < 2:
        return False
    subject = words[0]
    verb = words[1]
    if subject in ["he", "she"]:
        return verb in singular_verbs
    if subject in ["they", "we"]:
        return verb in plural_verbs
    return False
sentence = input("Enter sentence: ")
if check_agreement(sentence):
    print("Subject-verb agreement is correct.")
else:
    print("Subject-verb agreement is incorrect.")
