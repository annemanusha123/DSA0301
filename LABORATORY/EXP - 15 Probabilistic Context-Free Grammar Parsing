# PCFG Parser
grammar = {
    'S': [
        (['NP', 'VP'], 1.0)
    ],
    'NP': [
        (['Det', 'N'], 0.6),
        (['N'], 0.4)
    ],
    'VP': [
        (['V', 'NP'], 1.0)
    ],
    'Det': [
        (['the'], 0.5),
        (['a'], 0.5)
    ],
    'N': [
        (['cat'], 0.5),
        (['dog'], 0.5)
    ],
    'V': [
        (['sees'], 0.5),
        (['likes'], 0.5)
    ]
}
def parse(symbol, words, pos):
    if symbol not in grammar:
        if pos < len(words) and words[pos] == symbol:
            return [(pos + 1, 1.0)]
        return []
    results = []
    for rule, probability in grammar[symbol]:
        states = [(pos, probability)]
        for sym in rule:
            new_states = []
            for current_pos, prob in states:
                for next_pos, p in parse(sym, words, current_pos):
                    new_states.append(
                        (next_pos, prob * p)
                    )
            states = new_states
        results.extend(states)
    return results
sentence = input("Enter sentence: ").lower().split()
results = parse('S', sentence, 0)
valid = [
    probability
    for position, probability in results
    if position == len(sentence)
]

if valid:
    print("Sentence accepted.")
    print("Probability:", max(valid))
else:
    print("Sentence rejected.")
