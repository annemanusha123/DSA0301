from collections import defaultdict
corpus = [
    "I like NLP",
    "I like Python"
]
# Count unigrams
unigram = defaultdict(int)
words = []
for sentence in corpus:
    tokens = sentence.split()
    words.extend(tokens)
    for word in tokens:
        unigram[word] += 1
# Count bigrams
bigram = defaultdict(int)
for sentence in corpus:
    tokens = sentence.split()
    for i in range(len(tokens) - 1):
        bigram[(tokens[i], tokens[i + 1])] += 1
total_words = len(words)
previous_word = "like"
next_word = "Java"
# Backoff Language Model
if bigram[(previous_word, next_word)] > 0:
    probability = bigram[(previous_word, next_word)] / unigram[previous_word]
    print("Bigram Found")
    print("Probability =", probability)
else:
    probability = unigram[next_word] / total_words
    print("Bigram Not Found")
    print("Backoff to Unigram Probability =", probability)
