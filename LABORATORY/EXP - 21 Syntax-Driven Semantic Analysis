import spacy
# Load English NLP model
nlp = spacy.load("en_core_web_sm")
sentence = "The intelligent student solved the difficult programming problem."
doc = nlp(sentence)
print("Sentence:", sentence)
print("\nNoun Phrases and their meanings:")
for chunk in doc.noun_chunks:
    print("Noun Phrase:", chunk.text)
    print("Root:", chunk.root.text)
    print("Meaning:", f"The phrase refers to {chunk.text}.")
    print()
