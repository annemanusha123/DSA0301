import nltk
grammar = nltk.CFG.fromstring("""
S -> NP VP
NP -> 'I'
NP -> Det N
NP -> Det N PP
VP -> V NP
VP -> VP PP
PP -> P NP
Det -> 'the' | 'a'
N -> 'man' | 'telescope'
V -> 'saw'
P -> 'with'
""")
sentence = "I saw the man with a telescope".split()
parser = nltk.ChartParser(grammar)
print("Sentence:", " ".join(sentence))
print("\nTwo Possible Parse Structures:\n")
count = 0
for tree in parser.parse(sentence):
    count += 1
    print("Parse Structure", count)
    print(tree)
    tree.pretty_print()
    print()
print("Total Parse Structures:", count)
